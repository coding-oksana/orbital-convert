{
    "name": "orbital-convert-playground",
    "private": true,
    "version": "1.0.0",
    "description": "Convert satellite orbits between Keplerian elements and a Cartesian state vector.",
    "license": "MIT",
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "typecheck": "tsc -b",
        "lint": "eslint .",
        "fix": "eslint . --fix",
        "prettier": "prettier --write .",
        "test:e2e": "start-server-and-test dev http://localhost:5173 'cypress run'",
        "cy:open": "cypress open"
    },
    "dependencies": {
        "react": "^19.2.8",
        "react-dom": "^19.2.8"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^24.13.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^6.1.0",
        "cypress": "^16.1.1",
        "eslint": "^10.0.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.4",
        "globals": "^17.11.0",
        "prettier": "^3.9.9",
        "start-server-and-test": "^3.0.13",
        "tailwindcss": "^4.3.3",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.67.0",
        "vite": "^8.2.2"
    }
}